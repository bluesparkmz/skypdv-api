# SkyPDV API Configuration
DATABASE_URL=sqlite:///./skypdv.db

# SkyWallet Integration
SKYWALLET_GATEWAY_URL=https://skywallet.bluesparkmz.com
SKYWALLET_SERVICE_NAME=skypdv
SKYWALLET_API_KEY=your_skywallet_api_key_here
SKYWALLET_SIGNING_SECRET=your_skywallet_signing_secret_here

# Controla se o SkyPDV deve aplicar bloqueio/alerta de cobrança
# false -> não aplicar bloqueio; true -> aplicar bloqueio quando assinatura suspensa
SKYPDV_ACTIVATE_CHARGING=false
