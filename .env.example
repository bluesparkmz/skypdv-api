# SkyPDV API Configuration
DATABASE_URL=sqlite:///./skypdv.db

# SkyWallet Developer API (mesmo padrão do BlueSpark Cloud)
SKYWALLET_URL=https://skywallet-api.bluesparkmz.com
SKYWALLET_SK_ID=
SKYWALLET_API_KEY=
SKYWALLET_WEBHOOK_SECRET=
# Na credential SkyPDV (SkyWallet) define também:
# webhook_url=https://skypdvmz.bluesparkmz.com/manager/billing/skywallet/webhook
# webhook_secret=<mesmo valor de SKYWALLET_WEBHOOK_SECRET>

# Preços mensais em MZN (Básico ~$20, Pro ~$30)
SKYPDV_PLAN_BASIC_MZN=1300
SKYPDV_PLAN_PRO_MZN=1950

# Controla se o SkyPDV deve aplicar bloqueio por assinatura suspensa
# false -> não bloquear (recomendado por agora); true -> bloquear vendas
SKYPDV_ACTIVATE_CHARGING=false
